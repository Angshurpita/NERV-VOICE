# EchoSphere API — local development
# Copy to apps/api/.env and adjust. Never commit the real file.

PORT=3001
NODE_ENV=development

# Signs session cookies. Generate one with: openssl rand -base64 48
# Required in production; a temporary key is generated if absent in development.
AUTH_SECRET=

# Neon connection string. Leave blank to run entirely in memory (calls and
# tickets then vanish on restart, which is fine for local work).
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# ── Language model (optional) ─────────────────────────────────────────────────
# Without a key the deterministic engine still runs and replies come from
# templates chosen by the policy engine — every escalation rule still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ── Agora (optional) ──────────────────────────────────────────────────────────
# Required for the RTC audio transport and cloud voice agent.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_RTC_TOKEN_TTL=3600

# ── First-run admin ───────────────────────────────────────────────────────────
# Created only when the users table is empty. Disable in production.
SEED_ADMIN=true
SEED_ADMIN_EMAIL=admin@echosphere.dev
SEED_ADMIN_PASSWORD=Echosphere123
SEED_ADMIN_NAME=Ops Admin

# ── Escalation policy (requirement 6) ─────────────────────────────────────────
# How many times a caller must ask for a human before the call is handed over.
HUMAN_REQUESTS_BEFORE_HANDOVER=3
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.60
ORDER_ID_CONFIRMATION_THRESHOLD=0.85
IDENTITY_CONFIRMATION_THRESHOLD=0.85
HIGH_VALUE_INR=25000
