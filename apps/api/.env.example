# EchoSphere Backend API & Agora Conversational AI Agent Configuration
# Copy to apps/api/.env and configure with your credentials. Never commit the real file.

PORT=3001
NODE_ENV=development

# Signs session cookies and authenticates internal CustomLLM callbacks.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public URL of this API service (or ngrok/tunnel URL for local testing).
# REQUIRED for Agora Cloud Agent CustomLLM callbacks:
# Agora Cloud Agent routes caller speech to ${PUBLIC_URL}/api/agora/openai/v1/chat/completions
PUBLIC_URL=
# AGORA_LLM_URL=https://api.yourdomain.com/api/agora/openai/v1/chat/completions

# Neon PostgreSQL connection string. Leave blank to run in memory for quick demos.
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Origins allowed to send credentialed requests (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# ── Gemini Reasoning & Decision Brain ─────────────────────────────────────────
# Gemini powers the conversational phrasing inside EchoSphere's deterministic runTurn().
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Deepgram STT & Deepgram Aura TTS ──────────────────────────────────────────
# Speech recognition (STT) and voice synthesis (TTS) for the Agora Conversational AI Agent.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_HINDI_MODEL=nova-2

# ── Agora Conversational AI & RTC ─────────────────────────────────────────────
# Required for Agora RTC audio transport and Cloud Conversational AI Agent.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_RTC_TOKEN_TTL=3600

# ── First-run admin ───────────────────────────────────────────────────────────
SEED_ADMIN=true
SEED_ADMIN_EMAIL=admin@echosphere.dev
SEED_ADMIN_PASSWORD=Echosphere123
SEED_ADMIN_NAME=Ops Admin

# ── Escalation Policy ─────────────────────────────────────────────────────────
HUMAN_REQUESTS_BEFORE_HANDOVER=3
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.60
ORDER_ID_CONFIRMATION_THRESHOLD=0.85
IDENTITY_CONFIRMATION_THRESHOLD=0.85
HIGH_VALUE_INR=25000
